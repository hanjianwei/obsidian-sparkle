{
	"name": "obsidian-sparkle",
	"version": "0.2.1",
	"license": "MIT",
	"private": true,
	"description": "Capture ideas into your current note or daily note with quick or continuous capture.",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run && npm run test:release",
		"test:release": "node --test scripts/release.test.mjs",
		"release:check": "node scripts/version.mjs check",
		"version": "node scripts/version.mjs sync && git add manifest.json versions.json"
	},
	"devDependencies": {
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.5.0",
		"globals": "^17.6.0",
		"moment": "^2.31.0",
		"obsidian": "latest",
		"prettier": "^3.6.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"obsidian-daily-notes-interface": "^0.9.5"
	}
}
